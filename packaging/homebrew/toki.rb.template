# Toki's Homebrew formula (Phase 7, spec §10.4). Generated by
# packaging/build-release.ts from toki.rb.template: edit the template, not toki.rb.
#
# A formula, not a cask: Toki is scripts, a `toki` command and a background
# service, not a .app, so macOS Gatekeeper never applies.
class Toki < Formula
  include Language::Python::Virtualenv

  desc "Desk robot that shows what your Claude agents are doing"
  homepage "https://github.com/g1d30nB/toki"
  url "{{URL}}"
  sha256 "{{SHA256}}"
  license "MIT" # the code; the art is all rights reserved (art/LICENSE)

  depends_on "esptool" # talks to the robot's chip: backup, flash, restore
  depends_on :macos
  # Runs the bridge and the toki command (TypeScript, no build step). A versioned,
  # keg-only Node: plain "node" would be linked into the PATH and quietly change
  # the user's own `node` for every other project (found 10 Oct on Gideon's Mac).
  depends_on "node@24"
  depends_on "python@3.14" # the Wi-Fi setup over USB

  resource "pyserial" do
    url "https://files.pythonhosted.org/packages/1e/7d/ae3f0a63f41e4d2f6cb66a5b57197850f919f59e558159a4dd3a818f5082/pyserial-3.5.tar.gz"
    sha256 "3c77e014170dfffbd816e6ffc205e9842efb10be9f58ec16d3e8675b4925cddb"
  end

  def install
    libexec.install Dir["*"]
    venv = virtualenv_create(libexec/"venv", "python3.14")
    venv.pip_install resource("pyserial")
    # Stable "opt" paths, so what Toki writes into Claude Code's settings and the
    # login agent keeps working after `brew upgrade`.
    (bin/"toki").write <<~SH
      #!/bin/bash
      export TOKI_HOME="#{opt_libexec}"
      export TOKI_NODE="#{formula_opt_bin("node@24")}/node"
      export TOKI_PYTHON="#{opt_libexec}/venv/bin/python"
      exec "$TOKI_NODE" "$TOKI_HOME/bridge/src/cli.ts" "$@"
    SH
  end

  def caveats
    <<~EOS
      Toki is installed. Start here: it walks you through everything, one step at a time,
      and it's safe to run again whenever you like:
        toki setup

      Before removing Toki with `brew uninstall toki`, run
        toki stop && toki hooks uninstall
      so nothing is left pointing at it.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/toki version")
    assert_match "toki status", shell_output("#{bin}/toki help")
  end
end
